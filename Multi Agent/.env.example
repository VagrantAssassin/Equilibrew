# ─────────────────────────────────────────────────────────────
# Tea'n Brew Multi-Agent System — Environment Variables
# ─────────────────────────────────────────────────────────────
# Salin file ini menjadi .env lalu isi GROQ_API_KEY kamu
# cp .env.example .env

# API Groq (ambil di https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Settings
MAX_TOKENS=1500

# Hyperparameter per Agent
# Profile Agent: kreativitas tinggi untuk variasi profil karakter
PROFILE_TEMPERATURE=0.8
PROFILE_FREQUENCY_PENALTY=0.3
PROFILE_PRESENCE_PENALTY=0.2

# Dialogue Agent: seimbang antara kreatif dan konsisten untuk dialog natural
DIALOGUE_TEMPERATURE=0.5
DIALOGUE_FREQUENCY_PENALTY=0.4
DIALOGUE_PRESENCE_PENALTY=0.0

# Critic Agent: presisi tinggi untuk evaluasi yang konsisten
CRITIC_TEMPERATURE=0.2
CRITIC_FREQUENCY_PENALTY=0.1
CRITIC_PRESENCE_PENALTY=0.0

# Actor-Critic Settings
MAX_REVISI=2
CRITIC_THRESHOLD=70

# Mood Settings (nanti diganti inputan dari Unity)
MOOD_AWAL=50

# Sesi Curhat (turunkan ke 1-2 saat testing untuk hemat API)
RONDE_MIN=3
RONDE_MAX=5
