# ── OPSI 2: Azure langsung ───────────────────────────────────────────────────
API_URL="https://SkripsiMultiAgent.services.ai.azure.com/openai/v1"
API_KEY="DB8mhtcbJHd6kqqGx16CxYspcLr01BJ57SSQ20CHR23JM6JVIYY5JQQJ99CFACqBBLyXJ3w3AAAAACOGc7q3"
MODEL="GPT-5.4-mini"
PROFILE_MODEL="GPT-5.6-luna"
DIALOGUE_MODEL="GPT-5.6-luna"
CRITIC_MODEL="GPT-5.6-sol"

# ── OPSI 3: Groq ─────────────────────────────────────────────────────────────
# API_URL="https://api.groq.com/openai/v1"
# API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# MODEL=llama-3.3-70b-versatile

# ── SETTINGS (tidak perlu diubah untuk testing) ───────────────────────────────
MAX_TOKENS=4096
MAX_REVISI=2
CRITIC_THRESHOLD=4.0
MOOD_AWAL=50

# ── HYPERPARAMETER PER AGENT ─────────────────────────────────────────────────
# Profile Agent: kreativitas tinggi untuk variasi profil karakter
PROFILE_TEMPERATURE=0.8
PROFILE_FREQUENCY_PENALTY=0.3
PROFILE_PRESENCE_PENALTY=0.2

# Dialogue Agent: seimbang antara kreatif dan konsisten untuk dialog natural
DIALOGUE_TEMPERATURE=0.5
DIALOGUE_FREQUENCY_PENALTY=0.4
DIALOGUE_PRESENCE_PENALTY=0.0

# Critic Agent: presisi tinggi untuk evaluasi yang konsisten
CRITIC_TEMPERATURE=0.2
CRITIC_FREQUENCY_PENALTY=0.1
CRITIC_PRESENCE_PENALTY=0.0
RONDE_MIN=2
RONDE_MAX=4